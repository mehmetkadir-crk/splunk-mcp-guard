{
  "mcpServers": {
    "splunk-guarded": {
      "command": "C:\\path\\to\\splunk-mcp-guard\\.venv\\Scripts\\splunk-mcp-guard.exe",
      "args": [
        "--policy", "C:\\path\\to\\splunk-mcp-guard\\policy\\strict.yaml",
        "--backend", "C:\\path\\to\\splunk-mcp-guard\\examples\\backend.deslicer.json"
      ],
      "env": {
        "PYTHONIOENCODING": "utf-8",
        "PYTHONUTF8": "1",
        "GUARD_PRINCIPAL": "alice",
        "GUARD_AUDIT_PATH": "C:\\path\\to\\splunk-mcp-guard\\guard-audit.jsonl",
        "GUARD_APPROVAL_DIR": "C:\\path\\to\\guard-approvals",
        "GUARD_SPLUNK_HOST": "localhost",
        "GUARD_SPLUNK_PORT": "8089",
        "GUARD_SPLUNK_VERIFY_SSL": "true",
        "GUARD_SPLUNK_USERNAME": "mcp_svc",
        "GUARD_SPLUNK_PASSWORD": "<service account password>"
      }
    }
  }
}
